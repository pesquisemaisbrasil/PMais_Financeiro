# Copie para backend/.env. Nenhum valor aqui é real.

# Obrigatória, com pelo menos 32 caracteres (a API não sobe com menos). Gere uma própria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Cifra o segredo do MFA. Obrigatória: base64 de 32 bytes (a API não sobe com outro valor). Gere uma própria:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me

# HMAC da chave Pix. Obrigatória, com pelo menos 32 caracteres, e permanente: trocar invalida os hashes já gravados. Gere uma própria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PIX_SECRET_KEY=change-me

# Segundos entre as tentativas de reenviar ao Connect as baixas que ficaram esperando. 0 desliga (o `scripts/dispatch_payments.py` faz o mesmo na mão).
PAYMENT_DISPATCH_SECONDS=0

# API do P+ Connect (a de leitura já existe; baixa e busca de chave ainda não). Sem os três,
# o Connect fica fora do ar para o Financeiro. Em produção, só HTTPS. O segredo vem do Connect
# (`scripts/create_service_client.py`, mostrado uma vez).
CONNECT_BASE_URL=
CONNECT_CLIENT_ID=
CONNECT_CLIENT_SECRET=

# Deixe vazio. "simulated" liga um Connect de mentira (dados fictícios) para ver a tela de comprovantes sem o Connect; só fora de produção.
CONNECT_MODE=

# Postgres do docker-compose.yml. Nunca o banco do Connect.
DATABASE_URL=postgresql://financeiro_app:troque-local@localhost:5433/financeiro
# Role dona das tabelas, usada só pelo Alembic. Vazia = DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://financeiro_migrator:troque-local@localhost:5433/financeiro

# IP do proxy reverso, para o uvicorn confiar nos cabeçalhos dele. Só na imagem Docker.
FORWARDED_ALLOW_IPS=127.0.0.1

# production desliga /docs e /openapi.json.
ENVIRONMENT=development
# Endereços que o navegador alcança.
API_PUBLIC_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3010

# Login com Google e Microsoft. Vazio = o botão avisa que ainda não está disponível.
# No cadastro do app em cada provedor, a URL de retorno é:
#   <API_PUBLIC_URL>/auth/sso/google/callback e <API_PUBLIC_URL>/auth/sso/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Obrigatório para a Microsoft: limita o login às contas da empresa.
MICROSOFT_TENANT_ID=

# Só o front do Financeiro.
CORS_ORIGINS=http://localhost:3010
# false só em http://localhost. Em qualquer outro ambiente, deixe true.
REFRESH_COOKIE_SECURE=false

# Limpeza dos registros de login (pergunta Q26, com o DPO). Deixe vazio até ele aprovar os prazos:
# sem prazo, scripts/purge_login_data.py não faz nada. Propostas: 180 dias e 30 dias.
LOGIN_EVENTS_RETENTION_DAYS=
REFRESH_TOKENS_RETENTION_DAYS=

# Cofre dos documentos anexados às contas (MinIO). Vazio = anexar fica indisponível e a tela avisa.
# Local: o MinIO do docker compose (usuário e senha de desenvolvimento, que já estão no compose).
# FILES_MASTER_KEY: 32 bytes em base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# É permanente: sem ela, os arquivos já guardados não abrem. Guarde com backup à parte do banco.
FILES_ENDPOINT_URL=
FILES_BUCKET=financeiro-arquivos
FILES_ACCESS_KEY=
FILES_SECRET_KEY=
FILES_MASTER_KEY=
