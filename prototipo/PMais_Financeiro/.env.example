# Exemplo para desenvolvimento local. Nunca coloque valores reais neste arquivo.
# O .env local deve permanecer fora do Git.
PORT=3000

# Senha do gate exclusivo de demonstração. Forneça-a localmente pelo seu gerenciador de segredos.
# Não a salve em .env.example, fontes, Git, navegador, logs ou documentação.
# PMAIS_DEMO_LOGIN_PASSWORD=<configure fora do arquivo versionado>

# Opcional apenas em HTTP de loopback local; não definir no Preview ou em produção.
# PMAIS_DEMO_LOCAL_HTTP=1

# O Manus WebDev fornece DATABASE_URL e MANUS_* no runtime. Não os substitua aqui.
