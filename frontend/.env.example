# Copie para frontend/.env.local. É o endereço que o NAVEGADOR alcança.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Só no ambiente de teste publicado (site do protótipo): mostra a faixa "Ambiente de teste com dados fictícios"
# no topo de toda tela e o link de volta ao protótipo ("/" quando ele fica na raiz do mesmo site, ou um https://).
# Sem estas variáveis (desenvolvimento e produção), nada aparece.
# NEXT_PUBLIC_TEST_ENV=1
# NEXT_PUBLIC_PROTOTYPE_URL=/
